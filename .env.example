DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# Application
APP_NAME=CollabTrack
ENVIRONMENT=development
DEBUG=true

# Security / JWT
SECRET_KEY=change-me-generate-a-strong-random-key
ALGORITHM=XXXXX
ACCESS_TOKEN_EXPIRE_MINUTES=XXXX
RESET_TOKEN_EXPIRE_MINUTES=XX

# Frontend (OAuth redirects, invite links)
FRONTEND_URL=http://localhost:3000

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/integrations/github/callback

# Google OAuth — enable these APIs in Google Cloud Console for GOOGLE_CLIENT_ID:
#   - Google Drive API (doc metadata, comments, permissions)
#   - Google Drive Activity API (granular edit history per user)
#   - Google Docs API (optional, doc title/metadata)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/integrations/google/callback

# Admin seed (scripts/seed_admin.py)
ADMIN_EMAIL=admin@collabtrack.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=CollabTrack Admin

# Auto-provisioned student accounts (instructor roster flow)
DEFAULT_STUDENT_PASSWORD=ChangeMe123!

# Railway Object Storage (S3-compatible) for meeting session uploads
S3_ENDPOINT_URL=https://your-railway-endpoint
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION=auto
S3_PREFIX=collabtrack

# Fernet key for encrypting OAuth tokens (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# SMTP for supervisor report notifications (works locally).
# NOTE: Railway blocks outbound SMTP ports (25/465/587) on Trial/Hobby plans,
# so SMTP will not work in production there. Set RESEND_API_KEY below to send
# email over HTTPS instead (recommended for Railway).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD="your google app password"
SMTP_FROM_EMAIL=your@gmail.com

# Resend HTTP email API (used automatically when RESEND_API_KEY is set).
# Bypasses Railway's SMTP block. The from address must be on a domain you
# verified in Resend (or use onboarding@resend.dev for testing).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Gemini API for LLM-based participation scoring.
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_SCORING_ENABLED=true
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Moodle LTI 1.3 (external tool) — endpoints are mounted at /lti/* on the backend root
MOODLE_PLATFORM_ISS=https://your-moodle-site.example.com
MOODLE_CLIENT_ID=
MOODLE_DEPLOYMENT_ID=
MOODLE_AUTH_LOGIN_URL=https://your-moodle-site.example.com/mod/lti/auth.php
MOODLE_AUTH_TOKEN_URL=https://your-moodle-site.example.com/mod/lti/token.php
MOODLE_KEY_SET_URL=https://your-moodle-site.example.com/mod/lti/certs.php
LTI_LAUNCH_URL=https://your-backend.example.com/lti/launch
LTI_TOOL_PRIVATE_KEY=
LTI_TOOL_PUBLIC_KEY=

# Moodle web services (group + member import on instructor LTI launch)
MOODLE_BASE_URL=https://your-moodle-site.example.com
MOODLE_WS_TOKEN=

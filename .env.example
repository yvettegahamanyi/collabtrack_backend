# Copy this file to .env and fill in your real values.
# Railway provides a DATABASE_URL. Use the async driver scheme below.
#
# Railway usually gives you a URL starting with "postgresql://".
# For the async engine, change the scheme to "postgresql+asyncpg://".
#   Example: postgresql+asyncpg://user:password@host:port/dbname

DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# Application
APP_NAME=CollabTrack
ENVIRONMENT=development
DEBUG=true

# Security / JWT
# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30

# Admin seed (used by: python -m scripts.seed_admin)
ADMIN_EMAIL=admin@collabtrack.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=CollabTrack Admin

# Frontend base URL for invite links
FRONTEND_URL=http://localhost:3000
